{
  "title": "Lab 1",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Memory, % of limit",
     "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "fieldConfig": {"defaults": {"unit": "percent", "min": 0}, "overrides": []},
     "targets": [{"refId": "A", "legendFormat": "{{name}}",
       "expr": "100 * container_memory_working_set_bytes{name!=\"\"} / (container_spec_memory_limit_bytes{name!=\"\"} > 0)"}]},
    {"id": 2, "type": "timeseries", "title": "CPU, cores",
     "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
     "fieldConfig": {"defaults": {"min": 0}, "overrides": []},
     "targets": [{"refId": "A", "legendFormat": "{{name}}",
       "expr": "rate(container_cpu_usage_seconds_total{name!=\"\"}[1m])"}]},
    {"id": 3, "type": "timeseries", "title": "CPU throttling, % of periods",
     "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
     "fieldConfig": {"defaults": {"unit": "percent", "min": 0}, "overrides": []},
     "targets": [{"refId": "A", "legendFormat": "{{name}}",
       "expr": "100 * rate(container_cpu_cfs_throttled_periods_total{name!=\"\"}[1m]) / rate(container_cpu_cfs_periods_total{name!=\"\"}[1m])"}]}
  ]
}
